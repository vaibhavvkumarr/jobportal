PORT=3000

# Monthly price in rupees (whole number). Restart the server after changing.
PRICE_INR=499
ADMIN_WHATSAPP=9911634954

# MongoDB Atlas → Connect → Drivers → copy the connection string, put your password in it
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority&appName=Cluster0
MONGODB_DB=jobalert

# Password for the /admin page (username can be anything, e.g. admin)
ADMIN_PASSWORD=use-a-long-random-password
